# Variables de PRODUCCIÓN (VM). Copiar a .env y completar.
HTTP_PORT=8091
TZ=America/Argentina/Buenos_Aires

DB_NAME=notas_db
DB_USERNAME=notas
DB_PASSWORD=CAMBIAR_CLAVE_DB
DB_ROOT_PASSWORD=CAMBIAR_ROOT_DB

# openssl rand -base64 48
JWT_SECRET=CAMBIAR_SECRETO_48_BYTES

MINIO_ACCESS_KEY=CAMBIAR_MINIO_USER
MINIO_SECRET_KEY=CAMBIAR_MINIO_PASSWORD
MINIO_BUCKET=notasapp

CORS_ALLOWED_ORIGINS=https://notas.programandos.site
FRONTEND_URL=https://notas.programandos.site
MAIL_FROM=no-reply@notas.programandos.site

# Solo se usa si no existe ningún ADMIN
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@notas.local
BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_CLAVE_ADMIN
