# Variables de PRODUCCIÓN (VM). Copiar a .env y completar.
# Generar secretos con: openssl rand -base64 48 (JWT) y openssl rand -base64 32 (APP_ENCRYPTION_KEY)
HTTP_PORT=8091
TZ=America/Argentina/Buenos_Aires

DB_NAME=notas_db
DB_USERNAME=notas
DB_PASSWORD=CAMBIAR_CLAVE_DB
DB_ROOT_PASSWORD=CAMBIAR_ROOT_DB

JWT_SECRET=CAMBIAR_SECRETO_48_BYTES
APP_ENCRYPTION_KEY=CAMBIAR_CLAVE_32_BYTES

CORS_ALLOWED_ORIGINS=https://notas.programandos.site
FRONTEND_URL=https://notas.programandos.site

# Mail real en producción.
# Con Resend: MAIL_PROVIDER=resend, RESEND_API_KEY y REQUIRE_EMAIL_VERIFICATION=true.
# Con MailHog interno: MAIL_PROVIDER=mailhog, `docker compose ... --profile mail` y REQUIRE_EMAIL_VERIFICATION=false.
MAIL_PROVIDER=resend
RESEND_API_KEY=CAMBIAR_RESEND_API_KEY
MAIL_FROM=no-reply@notas.programandos.site
REQUIRE_EMAIL_VERIFICATION=true

# Solo se usa si no existe ningún ADMIN. Quitar después del primer arranque.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@notas.programandos.site
BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_CLAVE_ADMIN
