# Copiar a .env y completar. Nunca commitear .env.
DB_NAME=notas_db
DB_USERNAME=notas
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
DB_URL=jdbc:mysql://localhost:3306/notas_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# base64 de al menos 32 bytes: openssl rand -base64 48
JWT_SECRET=change-me-base64
COOKIE_SECURE=false
REFRESH_COOKIE_NAME=notasapp_rt

CORS_ALLOWED_ORIGINS=http://localhost:5173
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=notasapp

# Solo se usa si no existe ningún ADMIN.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# R3: MailHog dev / Resend prod
MAIL_PROVIDER=mailhog
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=notasapp@local.test
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=

# R3: antivirus (requiere perfil compose "av")
ANTIVIRUS_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
